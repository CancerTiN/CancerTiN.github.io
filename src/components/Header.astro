---
import Weave from './Weave.astro';

interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
const path = Astro.url.pathname;
const current = (prefix: string) => (path.startsWith(prefix) ? 'page' : undefined);
---

<header class="site-header">
  {
    home ? (
      <span />
    ) : (
      <a class="brand" href="/">
        <Weave id="brand" cell={2.6} />
        <span class="visually-hidden">jacquard 首页</span>
      </a>
    )
  }
  <nav class="site-nav" aria-label="主导航">
    <a href="/posts/" aria-current={current('/posts/')}>文章</a>
    <a href="/about/" aria-current={current('/about/')}>关于</a>
    <button type="button" class="search-trigger" data-search-open aria-haspopup="dialog">
      搜索<kbd data-search-kbd>⌘K</kbd>
    </button>
  </nav>
</header>
