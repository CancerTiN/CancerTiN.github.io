---
// ⌘K / Ctrl K 打开的站内搜索。索引由 Pagefind 在构建后生成（npm run build），全部在浏览器里检索。
---

<dialog class="search" aria-label="搜索文章">
  <div class="search-bar">
    <label class="visually-hidden" for="search-input">搜索文章</label>
    <input id="search-input" type="search" autocomplete="off" spellcheck="false" enterkeyhint="go" placeholder="搜索文章" />
    <button type="button" class="search-close" data-search-close>关闭</button>
  </div>
  <p class="search-status" aria-live="polite">输入关键词，搜索全部文章。</p>
  <ul class="search-results"></ul>
</dialog>

<script>
  interface Hit {
    url: string;
    excerpt: string;
    meta: { title?: string };
  }
  interface Pagefind {
    options(o: Record<string, unknown>): Promise<void>;
    init(): Promise<void>;
    debouncedSearch(q: string, o?: Record<string, unknown>, ms?: number): Promise<{ results: { data(): Promise<Hit> }[] } | null>;
  }

  const dialog = document.querySelector<HTMLDialogElement>('dialog.search')!;
  const input = dialog.querySelector<HTMLInputElement>('#search-input')!;
  const status = dialog.querySelector<HTMLParagraphElement>('.search-status')!;
  const list = dialog.querySelector<HTMLUListElement>('.search-results')!;
  const isMac = /Mac|iPhone|iPad/.test(navigator.userAgent);
  const IDLE = '输入关键词，搜索全部文章。';

  document.querySelectorAll('[data-search-kbd]').forEach((kbd) => (kbd.textContent = isMac ? '⌘K' : 'Ctrl K'));

  let pagefind: Pagefind | null = null;
  let failed = false;
  async function load(): Promise<Pagefind | null> {
    if (pagefind || failed) return pagefind;
    try {
      const url = new URL('/pagefind/pagefind.js', location.origin).href;
      const mod = (await import(/* @vite-ignore */ url)) as Pagefind;
      await mod.options({ excerptLength: 28 });
      await mod.init();
      pagefind = mod;
    } catch {
      failed = true;
    }
    return pagefind;
  }

  let active = -1;
  function links() {
    return [...list.querySelectorAll<HTMLAnchorElement>('a')];
  }
  function setActive(i: number) {
    const items = links();
    if (!items.length) return;
    active = (i + items.length) % items.length;
    items.forEach((a, k) => a.toggleAttribute('data-active', k === active));
    items[active].scrollIntoView({ block: 'nearest' });
  }

  function escapeHtml(s: string) {
    return s.replace(/[&<>"']/g, (ch) => `&#${ch.charCodeAt(0)};`);
  }

  function render(hits: Hit[]) {
    list.innerHTML = hits
      .map(
        (hit) =>
          `<li><a href="${escapeHtml(hit.url)}"><span class="search-title">${escapeHtml(hit.meta.title ?? hit.url)}</span>` +
          `<span class="search-excerpt">${hit.excerpt}</span></a></li>`,
      )
      .join('');
    active = -1;
    if (hits.length) setActive(0);
  }

  async function search() {
    const q = input.value.trim();
    if (!q) {
      render([]);
      status.textContent = IDLE;
      return;
    }
    const pf = await load();
    if (!pf) {
      status.textContent = import.meta.env.DEV
        ? '开发模式下没有搜索索引：先运行 npm run build，再用 npm run preview 打开。'
        : '搜索索引没有加载成功，刷新页面再试。';
      return;
    }
    const result = await pf.debouncedSearch(q, {}, 180);
    if (!result || input.value.trim() !== q) return;
    const hits = await Promise.all(result.results.slice(0, 8).map((r) => r.data()));
    if (input.value.trim() !== q) return;
    render(hits);
    status.textContent = hits.length
      ? `找到 ${result.results.length} 篇相关的文章${result.results.length > hits.length ? `，列出前 ${hits.length} 篇` : ''}。`
      : `没有找到和「${q}」相关的文章，换个词试试。`;
  }

  function open() {
    if (dialog.open) return;
    dialog.showModal();
    input.select();
    load();
  }

  function isTyping(target: EventTarget | null) {
    return target instanceof HTMLElement && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName));
  }

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dialog.open ? dialog.close() : open();
    } else if (e.key === '/' && !dialog.open && !isTyping(e.target)) {
      e.preventDefault();
      open();
    }
  });

  // 用拼音输入法时，选字完成后再搜，不拿半截拼音去查。
  input.addEventListener('input', (e) => {
    if (!(e as InputEvent).isComposing) search();
  });
  input.addEventListener('compositionend', search);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !e.isComposing) {
      // 搜索框默认按 Esc 只清空内容；这里让 Esc 一次就关掉。
      e.preventDefault();
      dialog.close();
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      setActive(active + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(active - 1);
    } else if (e.key === 'Enter' && !e.isComposing) {
      const target = links()[active];
      if (target) {
        e.preventDefault();
        location.href = target.href;
      }
    }
  });

  document.querySelectorAll('[data-search-open]').forEach((el) => el.addEventListener('click', open));
  dialog.querySelector('[data-search-close]')!.addEventListener('click', () => dialog.close());
  // 点对话框外面的遮罩也能关掉。
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
